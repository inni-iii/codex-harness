{
  "description": "Reviewed lessons and metadata-only checkpoints; review and trust these definitions in Codex /hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/harness/scripts/knowledge-hook.py\"",
            "timeout": 5,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/harness/scripts/knowledge-hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/harness/scripts/knowledge-hook.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
